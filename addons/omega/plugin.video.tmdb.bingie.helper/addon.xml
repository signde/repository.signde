<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.tmdb.bingie.helper"
version="2.1.0.3"
name="TMDb Bingie Helper"
provider-name="jurialmunkey,matke">
<requires>
  <import addon="xbmc.python" version="3.0.1"/>
  <import addon="script.module.requests" version="2.9.1"/>
  <import addon="script.module.pil" version="1.1.7"/>
  <import addon="script.module.addon.signals" version="0.0.6" />
  <import addon="script.module.bingie" version="1.0.1" />
  <import addon="script.module.infotagger" version="0.0.5" />
  <import addon="script.module.beautifulsoup4" version="4.9.3" />
  <import addon="script.module.qrcode" version="6.1.0" />
</requires>
<extension point="xbmc.python.pluginsource" library="resources/plugin.py">
  <provides>video</provides>
</extension>
<extension point="xbmc.python.script" library="resources/script.py" />
<extension point="xbmc.service" library="resources/service.py" />
<extension point="xbmc.python.module" library="resources/modules"/>
<extension point="xbmc.addon.metadata">
  <reuselanguageinvoker>false</reuselanguageinvoker>
  <summary lang="en_GB">TMDb Bingie Helper</summary>
  <description lang="en_GB">TMDb Bingie Helper provides details about movies, tvshows and actors from TMDb. Users can access a variety of lists from TMDb TVDb MDbList and Trakt.</description>
  <disclaimer lang="en_GB">Data provided by TMDb TVDb MDbList OMDb FanartTV and Trakt. Some of the information is provided by TheTVDB.com. Please consider supporting them. https://thetvdb.com/subscribe</disclaimer>
  <license>GPL-3.0-or-later</license>
  <website>https://github.com/signde/plugin.video.tmdb.bingie.helper</website>
  <news>
    [I][COLOR FFFF9800]v2.1.0.3[/COLOR][/I][CR]- Updated to upstream v1.0.3[CR]- Fixed Trakt sync pagination and progress data[CR]- Restored Wikipedia and added language selection[CR]- Improved cache and API response handling
  </news>
  <assets>
    <icon>icon.png</icon>
    <fanart>fanart.jpg</fanart>
    <screenshot>resources/screenshot-01.jpg</screenshot>
    <screenshot>resources/screenshot-02.jpg</screenshot>
  </assets>
</extension>
</addon>
